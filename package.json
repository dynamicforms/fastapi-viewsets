{
  "name": "@dynamicforms/fastapi-viewsets",
  "private": false,
  "version": "0.6.1",
  "type": "module",
  "description": "RESTful viewsets for Vue",
  "author": "Jure Erznožnik",
  "files": [
    "dist/*"
  ],
  "main": "dist/fastapi-viewsets.umd.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/fastapi-viewsets.umd.cjs",
      "import": "./dist/fastapi-viewsets.js"
    },
    "./styles.css": "./dist/fastapi-viewsets.css"
  },
  "workspaces": [
    "docs",
    "demo/frontend",
    "demo/e2e"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run --coverage",
    "lint": "eslint vue --fix && vue-tsc --noEmit",
    "lint:ci": "eslint vue && vue-tsc --noEmit",
    "docs:dev": "npm run docs:dev -w docs",
    "docs:build": "npm run docs:build -w docs",
    "docs:preview": "npm run docs:preview -w docs",
    "demo:dev": "npm run dev -w demo-frontend",
    "test:e2e": "npm run test:e2e -w demo-e2e"
  },
  "keywords": [
    "vue",
    "dynamicforms",
    "velis",
    "viewsets"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git@github.com:dynamicforms/fastapi-viewsets.git"
  },
  "issues": "https://github.com/dynamicforms/fastapi-viewsets/issues",
  "peerDependencies": {
    "@dynamicforms/translatable": "^0.1.0",
    "@dynamicforms/vue-forms": "^1.0.0",
    "axios": "^1.13.6",
    "lodash-es": "^4.17.12",
    "vue": "^3.4",
    "muxws": "^0.3.1"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26",
    "@vitejs/plugin-vue": "^6",
    "@vitest/coverage-v8": "^4",
    "@vue/test-utils": "^2.2.4",
    "@vue/tsconfig": "^0.7.0",
    "eslint-config-velis": "^3",
    "jsdom": "^26.0.0",
    "rollup-plugin-visualizer": "^5.14.0",
    "typescript": "^5",
    "vite": "^8",
    "vite-plugin-dts": "^4",
    "vitest": "^4",
    "vue-tsc": "^2"
  },
  "peerDependenciesMeta": {
    "muxws": {
      "optional": true
    }
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
