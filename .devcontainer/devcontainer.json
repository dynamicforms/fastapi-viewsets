{
  "name": "fastapi-viewsets demo",
  "dockerComposeFile": "compose.yaml",
  "service": "app",
  "workspaceFolder": "/workspaces/fastapi-viewsets",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "hostRequirements": { "cpus": 4 },
  "postCreateCommand": "pipx install uv && uv sync --locked && npm ci",
  "postAttachCommand": "curl -sf -o /dev/null localhost:5173 && echo 'The demo is already running.' || uv run python demo.py --benchmark",
  // No forwardPorts: the ports are forwarded when the demo starts listening, and onAutoForward opens the frontend.
  "portsAttributes": {
    "5173": { "label": "Demo", "onAutoForward": "openBrowserOnce" },
    "8000": { "label": "Demo API", "onAutoForward": "silent" },
    "8010-8019": { "label": "Benchmark processes", "onAutoForward": "ignore" }
  },
  // No venv activation in terminals: it types into the demo's terminal and interrupts the demo; uv run needs none.
  "customizations": {
    "codespaces": { "openFiles": [".devcontainer/README.md"] },
    "vscode": {
      "settings": {
        "python.terminal.activateEnvironment": false,
        "python-envs.terminal.autoActivationType": "off"
      },
      "extensions": ["ms-python.python", "charliermarsh.ruff", "Vue.volar"]
    }
  }
}
