{
  "name": "fastapi-viewsets demo",
  "dockerComposeFile": "compose.yaml",
  "service": "app",
  "workspaceFolder": "/workspaces/fastapi-viewsets",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "hostRequirements": { "cpus": 2 },
  "postCreateCommand": "pipx install uv && uv sync --locked && npm ci",
  "postAttachCommand": "curl -sf -o /dev/null localhost:5173 && echo 'The demo is already running.' || uv run python demo.py",
  "forwardPorts": [5173, 8000],
  "portsAttributes": {
    "5173": { "label": "Demo", "onAutoForward": "openBrowser" },
    "8000": { "label": "Demo API", "onAutoForward": "silent" }
  },
  "customizations": {
    "codespaces": { "openFiles": [".devcontainer/README.md"] },
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff", "Vue.volar"]
    }
  }
}
